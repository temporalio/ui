{
  "name": "temporalio-ui-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "pnpm": ">=10.10.0",
    "node": "^22.23.4"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "prepare": "husky install",
    "build:server": "pnpm --filter @temporalio/ui build:server",
    "build": "pnpm --filter @temporalio/ui build:local",
    "test": "pnpm --filter @temporalio/ui test",
    "check": "pnpm -r check",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}
