# Copy this file to .env.ui-server-cloud.local (gitignored), fill in the
# values, then, from the repo root:
#
#   docker compose -f docker-compose.cloud.yml up --build -d
#
# and open http://localhost:8080/namespaces/<namespace>/workflows
# The image serves the Cloud-target UI and the API from the same port.

# Regional endpoint. API keys authenticate here, and the ui-server sends a
# temporal-namespace header derived from each request.
TEMPORAL_ADDRESS=<region>.<cloud-provider>.api.temporal.io:7233
TEMPORAL_API_KEY=<api-key>
TEMPORAL_DEFAULT_NAMESPACE=<namespace>.<account-id>

# Without a server name (or CA/cert) the ui-server dials insecurely, which
# Temporal Cloud rejects. Use the host part of TEMPORAL_ADDRESS.
TEMPORAL_TLS_SERVER_NAME=<region>.<cloud-provider>.api.temporal.io
TEMPORAL_TLS_ENABLE_HOST_VERIFICATION=true

TEMPORAL_UI_PORT=8080
