# Catalog worker defaults for local development.
# The UI picks its namespace from the URL; these values only aim the worker.
# Task queues always come from each target's registration and cannot be set here.
# Override any value in .env.catalog.local (gitignored) — see
# .env.catalog.local.example for credential configurations.
# 127.0.0.1 (not localhost) so the worker always reaches the same server as
# the UI even when another process publishes 7233 on IPv6 (for example Docker).
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
