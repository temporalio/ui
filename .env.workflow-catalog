# Workflow catalog worker defaults for local development.
# The UI picks its namespace from the URL; these values only aim the worker.
# Task queues always come from each target's registration and cannot be set here.
# Override any value in .env.workflow-catalog.local (gitignored) — see
# .env.workflow-catalog.local.example for credential configurations.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
