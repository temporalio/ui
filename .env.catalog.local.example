# Copy this file to .env.catalog.local (gitignored) and uncomment one
# configuration. Values here override the committed .env.catalog
# defaults; real environment variables override both.
#
# The worker registers and polls in TEMPORAL_NAMESPACE. The UI shows the
# catalog for whichever namespace is in the URL, so browse the same namespace
# the worker points at. Task queues always come from each target's
# registration and cannot be configured here.

# --- Local server in another namespace ---
# Prefer 127.0.0.1 over localhost: localhost can resolve to IPv6 and reach a
# different server (for example a Docker container publishing the same port).
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=my-namespace

# --- Temporal Cloud with an API key ---
# TEMPORAL_ADDRESS=<region>.<cloud-provider>.api.temporal.io:7233
# TEMPORAL_NAMESPACE=<namespace>.<account-id>
# TEMPORAL_API_KEY=<api-key>

# --- Temporal Cloud with an mTLS certificate pair (base64-encoded) ---
# TEMPORAL_ADDRESS=<namespace>.<account-id>.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=<namespace>.<account-id>
# TEMPORAL_TLS_CERT=<base64 client certificate>
# TEMPORAL_TLS_KEY=<base64 client private key>

# --- mTLS with a private CA or server name override ---
# TEMPORAL_TLS_CLIENT_CERT_BASE64=<base64 client certificate>
# TEMPORAL_TLS_CLIENT_KEY_BASE64=<base64 client private key>
# TEMPORAL_TLS_SERVER_ROOT_CA_CERT_BASE64=<base64 CA certificate>
# TEMPORAL_TLS_SERVER_NAME_OVERRIDE=<server name>

# Exactly one credential mode may be set: an API key cannot be combined with
# any TLS variable, and certificate/key halves must be provided together.

# Run only one catalog target instead of all of them:
# CATALOG_TARGET_ID=shared-workflows
